# ================================
# API Configuration
# ================================

# Backend API URL
# Development (local):
REACT_APP_API_URL=http://localhost:5000/api

# Production (replace with your backend URL):
# REACT_APP_API_URL=https://your-backend-domain.com/api

# ================================
# Application Settings
# ================================

REACT_APP_NAME=AI Puzzle Game
REACT_APP_VERSION=1.0.0

# ================================
# Notes
# ================================

# 1. Variables must start with REACT_APP_
# 2. Changes require a restart of the dev server
# 3. Never put secrets here — they are exposed in the browser build
# 4. Copy this file to .env for local development: cp .env.example .env
