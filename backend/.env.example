# ================================
# Flask Configuration
# ================================

# Secret key for session management
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=True

# Flask environment (development, production, testing)
FLASK_ENV=development

# ================================
# Unsplash API Configuration
# ================================

# Get your free API keys from: https://unsplash.com/developers
# Free tier: 50 requests per hour
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here

# ================================
# Database Configuration
# ================================

# PostgreSQL (recommended)
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/puzzle_game_db

# SQLite alternative (no setup needed for development)
# DATABASE_URL=sqlite:///puzzle_game.db

# ================================
# JWT Configuration
# ================================

# Secret key for signing JWT tokens
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# ================================
# CORS Configuration
# ================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ================================
# Validation Settings
# ================================

VALIDATION_THRESHOLD=0.75
USE_ENSEMBLE_VALIDATION=False
FAST_MODE=False

# ================================
# Application Settings
# ================================

MAX_CONTENT_LENGTH=16777216
MAX_IMAGE_DIMENSION=1200
PUZZLE_PIECE_SIZE=150
DECOY_COUNT=4

# ================================
# Logging
# ================================

LOG_LEVEL=INFO
